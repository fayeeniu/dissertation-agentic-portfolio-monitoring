# Local-only configuration. Never commit a populated .env file.
PORTFOLIO_DATABASE_URL=sqlite:///var/portfolio.db
PORTFOLIO_RAW_DATA_DIR=var/raw
PORTFOLIO_OPENAI_MODEL=gpt-5.4-mini
PORTFOLIO_OPENAI_ESCALATION_MODEL=gpt-5.4
PORTFOLIO_ALLOW_EXTERNAL_LLM=false
# OPENAI_API_KEY is intentionally omitted. Set it only in the process environment.

