# Local-only configuration template. Docker Compose reads this file for explicit interpolation;
# native `serve` reads process variables and does not source it.
# Never commit a populated .env file.
PORTFOLIO_DATABASE_URL=sqlite:///var/portfolio.db
PORTFOLIO_RAW_DATA_DIR=var/raw
PORTFOLIO_SOURCE_SNAPSHOT_DIR=var/sources
PORTFOLIO_REVIEWER_NAME="Replace with accountable local reviewer name"
# Live company research requires both flags, a public reviewed case, reviewer name, and API key.
PORTFOLIO_ALLOW_LIVE_PUBLIC_RETRIEVAL=false
PORTFOLIO_ENABLE_SYNTHETIC_FIXTURE_CONNECTOR=false
# GPT-5.6 Luna handles captured-corpus selection, repeat attempts, and portfolio extraction.
PORTFOLIO_OPENAI_MODEL=gpt-5.6-luna
# Kept as a compatibility setting; broad discovery also uses GPT-5.6 Luna.
PORTFOLIO_OPENAI_ESCALATION_MODEL=gpt-5.6-luna
# Reasoning effort for broad discovery: low, medium, or high.
PORTFOLIO_OPENAI_REASONING_EFFORT=medium
PORTFOLIO_ALLOW_EXTERNAL_LLM=false
PORTFOLIO_HTTP_TIMEOUT_SECONDS=10
PORTFOLIO_HTTP_MAX_RESPONSE_BYTES=5242880
PORTFOLIO_HTTP_MAX_ATTEMPTS=3
# Separate from the 10-second public-page fetch bound: reasoning plus web search can take longer.
PORTFOLIO_OPENAI_TIMEOUT_SECONDS=120
PORTFOLIO_COMPANY_RESEARCH_MAX_SOURCES=24
PORTFOLIO_COMPANY_RESEARCH_MAX_TOOL_CALLS=12
PORTFOLIO_COMPANY_RESEARCH_MAX_SOURCE_CHARS=12000
PORTFOLIO_COMPANY_RESEARCH_MAX_CORPUS_CHARS=160000
PORTFOLIO_COMPANY_RESEARCH_MAX_OUTPUT_TOKENS=10000
PORTFOLIO_COMPANY_RESEARCH_MAX_REDIRECTS=3
# End-to-end execution budget from the first claimed stage through composition.
PORTFOLIO_COMPANY_RESEARCH_MAX_ELAPSED_SECONDS=240
# Docker Compose passes this key into the local app container at runtime; it is never copied into
# the image. Native `serve` still requires it in the process environment. The smoke command may
# also load it from a private mode-0600 `.env`.
# Keep the populated .env private (`chmod 600 .env`) and never commit it.
OPENAI_API_KEY=
