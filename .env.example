# Local-only configuration. Never commit a populated .env file.
PORTFOLIO_DATABASE_URL=sqlite:///var/portfolio.db
PORTFOLIO_RAW_DATA_DIR=var/raw
PORTFOLIO_SOURCE_SNAPSHOT_DIR=var/sources
PORTFOLIO_REVIEWER_NAME=Replace with accountable local reviewer name
# Hard-gated: true makes the default runtime refuse startup until G2 is closed and wired.
PORTFOLIO_ALLOW_LIVE_PUBLIC_RETRIEVAL=false
PORTFOLIO_ENABLE_SYNTHETIC_FIXTURE_CONNECTOR=false
PORTFOLIO_OPENAI_MODEL=gpt-5.4-mini
PORTFOLIO_OPENAI_ESCALATION_MODEL=gpt-5.4
# Hard-gated: true makes the default runtime refuse startup; G4 experiments inject a provider.
PORTFOLIO_ALLOW_EXTERNAL_LLM=false
PORTFOLIO_HTTP_TIMEOUT_SECONDS=10
PORTFOLIO_HTTP_MAX_RESPONSE_BYTES=5242880
PORTFOLIO_HTTP_MAX_ATTEMPTS=3
PORTFOLIO_OPENAI_TIMEOUT_SECONDS=30
# OPENAI_API_KEY is intentionally omitted. Set it only in the process environment.
